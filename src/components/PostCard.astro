---
import type { CollectionEntry } from 'astro:content';
import MediaBadge from './MediaBadge.astro';
import { formatRelative, stripLeadingUrls, toPersianDigits } from '../lib/format';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { data } = post;

const preview = stripLeadingUrls(data.text);
const hashtags = Array.from(
  data.text.matchAll(/#([\p{L}\p{N}_]+)/gu),
  (match) => match[1] ?? '',
).filter(Boolean);
const tags = [...new Set([...(data.category ? [data.category] : []), ...hashtags])].slice(0, 3);

const postHref = `/post/${data.id}`;
const views = toPersianDigits(data.views);
const reactions = toPersianDigits(data.reactions);
const relativeDate = formatRelative(data.date);
---

<article
  class="group relative flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md hover:ring-2 hover:ring-brand-blue/40 focus-within:ring-2 focus-within:ring-brand-blue/40 dark:border-slate-700 dark:bg-slate-900 dark:shadow-slate-950/40"
>
  <a
    href={postHref}
    class="absolute inset-0 z-0 rounded-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue"
    aria-label={`مشاهدهٔ پست ${toPersianDigits(data.id)}`}
  ></a>

  <div class="pointer-events-none relative z-10 flex h-full flex-col">
    <div class="flex items-start justify-between gap-3">
      <MediaBadge type={data.media_type} duration={data.duration_sec} size="sm" />
      <time
        datetime={data.date.toISOString()}
        class="shrink-0 text-[11px] text-slate-500 dark:text-slate-400"
      >
        {relativeDate}
      </time>
    </div>

    {
      preview ? (
        <p class="mt-3 line-clamp-3 whitespace-pre-line text-sm leading-7 text-slate-700 dark:text-slate-300">
          {preview}
        </p>
      ) : (
        <p class="mt-3 text-sm italic text-slate-400 dark:text-slate-500">بدون متن</p>
      )
    }

    <div class="mt-auto pt-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex min-w-0 flex-wrap items-center gap-1.5">
          {
            tags.map((tag) => (
              <span class="max-w-full truncate rounded-full bg-slate-100 px-2 py-0.5 text-[11px] text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                #{tag}
              </span>
            ))
          }
        </div>
        <div class="flex shrink-0 items-center gap-3 text-[11px] text-slate-500 dark:text-slate-400">
          <span aria-label={`${views} بازدید`}>👁 {views}</span>
          <span aria-label={`${reactions} واکنش`}>❤️ {reactions}</span>
        </div>
      </div>

      <a
        href={data.telegram_link}
        target="_blank"
        rel="noopener noreferrer"
        onclick="event.stopPropagation()"
        class="pointer-events-auto relative z-20 mt-4 inline-flex w-full items-center justify-center gap-1.5 rounded-xl bg-brand-blue px-3 py-2 text-xs font-semibold text-white transition hover:bg-brand-blue-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue-light focus-visible:ring-offset-2 dark:bg-brand-blue-light dark:text-slate-950 dark:hover:bg-brand-blue dark:focus-visible:ring-offset-slate-900"
      >
        <span aria-hidden="true">▶</span>
        مشاهده در تلگرام
      </a>
    </div>
  </div>
</article>
