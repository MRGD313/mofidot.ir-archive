---
import { mediaEmoji, type MediaType } from '../lib/format';

interface Props {
  categories: string[];
  activeCategory: string | null;
  activeMedia: string | null;
}

const { categories, activeCategory, activeMedia } = Astro.props;

const mediaOptions: Array<{ value: MediaType; label: string }> = [
  { value: 'voice', label: 'وویس' },
  { value: 'video', label: 'ویدیو' },
  { value: 'photo', label: 'تصویر' },
  { value: 'document', label: 'فایل' },
  { value: 'text', label: 'متن' },
];

function hrefFor(category: string | null, media: string | null): string {
  const params = new URLSearchParams();
  if (category) params.set('cat', category);
  if (media) params.set('media', media);
  const query = params.toString();
  return query ? `${Astro.url.pathname}?${query}` : Astro.url.pathname;
}

const chipBase =
  'inline-flex shrink-0 snap-start items-center justify-center gap-1.5 whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-medium ring-1 ring-inset transition focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue data-[active=true]:bg-brand-blue data-[active=true]:text-white data-[active=true]:ring-brand-blue data-[active=true]:shadow-sm dark:data-[active=true]:bg-brand-blue-light dark:data-[active=true]:text-slate-950 dark:data-[active=true]:ring-brand-blue-light';
const chipInactive =
  'bg-white/80 text-slate-700 ring-slate-300 hover:bg-slate-100 dark:bg-slate-900/80 dark:text-slate-300 dark:ring-slate-700 dark:hover:bg-slate-800';
---

<section
  data-pagefind-ignore
  aria-label="فیلتر پست‌ها"
  class="sticky top-16 z-30 -mx-4 mb-6 space-y-2 border-y border-slate-200 bg-slate-50/95 px-4 py-3 shadow-[0_10px_22px_-18px_rgba(15,23,42,0.65)] backdrop-blur sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 dark:border-slate-800 dark:bg-slate-950/95"
>
  <div class="flex flex-wrap items-center gap-2">
    <span class="ml-1 shrink-0 text-xs font-semibold text-slate-500 dark:text-slate-400">دسته:</span>
    <a
      href={hrefFor(null, activeMedia)}
      data-filter="cat"
      data-value=""
      data-active={activeCategory ? 'false' : 'true'}
      aria-current={activeCategory ? undefined : 'page'}
      class:list={[chipBase, chipInactive]}
    >
      همه
      {
        !activeCategory && (
          <span class="h-1.5 w-1.5 rounded-full bg-brand-red" aria-hidden="true"></span>
        )
      }
    </a>
    {
      categories.map((category) => {
        const active = activeCategory === category;
        return (
          <a
            href={hrefFor(category, activeMedia)}
            data-filter="cat"
            data-value={category}
            data-active={active ? 'true' : 'false'}
            aria-current={active ? 'page' : undefined}
            class:list={[chipBase, chipInactive]}
          >
            {category}
          </a>
        );
      })
    }
  </div>

  <div class="flex snap-x snap-mandatory items-center gap-2 overflow-x-auto pb-1 [scrollbar-width:none] sm:flex-wrap sm:overflow-visible sm:snap-none [&::-webkit-scrollbar]:hidden">
    <span class="ml-1 shrink-0 text-xs font-semibold text-slate-500 dark:text-slate-400">نوع:</span>
    <a
      href={hrefFor(activeCategory, null)}
      data-filter="media"
      data-value=""
      data-active={activeMedia ? 'false' : 'true'}
      aria-current={activeMedia ? undefined : 'page'}
      class:list={[chipBase, chipInactive]}
    >
      همه
    </a>
    {
      mediaOptions.map((option) => {
        const active = activeMedia === option.value;
        return (
          <a
            href={hrefFor(activeCategory, option.value)}
            data-filter="media"
            data-value={option.value}
            data-active={active ? 'true' : 'false'}
            aria-current={active ? 'page' : undefined}
            class:list={[chipBase, chipInactive]}
          >
            <span aria-hidden="true">{mediaEmoji(option.value)}</span>
            {' '}
            {option.label}
          </a>
        );
      })
    }
  </div>
</section>
