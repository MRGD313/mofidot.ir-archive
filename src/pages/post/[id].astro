---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaBadge from '../../components/MediaBadge.astro';
import {
  categorySlug,
  formatDate,
  formatRelative,
  mediaEmoji,
  mediaLabel,
  stripLeadingUrls,
  toPersianDigits,
} from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { id: String(post.data.id) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { data } = post;

const plainText = stripLeadingUrls(data.text);
const firstLine = plainText.split('\n')[0]?.trim() ?? '';
const postTitle = firstLine
  ? firstLine.length > 80
    ? `${firstLine.slice(0, 80)}…`
    : firstLine
  : `پست ${toPersianDigits(data.id)}`;
const excerpt =
  plainText.replace(/\s+/g, ' ').trim().slice(0, 160) || 'پست کانال تلگرام مفیدات';

const escapeMap: Record<string, string> = {
  '&': '&amp;',
  '<': '&lt;',
  '>': '&gt;',
  '"': '&quot;',
  "'": '&#39;',
};

function escapeHtml(value: string): string {
  return value.replace(/[&<>"']/g, (character) => escapeMap[character] ?? character);
}

function linkify(value: string): string {
  return escapeHtml(value).replace(/(https?:\/\/[^\s<]+)/g, (match) => {
    const trailing = match.match(/[.,!?؛،»)\]}]+$/u)?.[0] ?? '';
    const url = trailing ? match.slice(0, -trailing.length) : match;
    return `<a href="${url}" target="_blank" rel="noopener noreferrer" class="break-all text-sky-600 underline decoration-sky-400/60 underline-offset-2 hover:text-sky-500 dark:text-sky-400 dark:hover:text-sky-300">${url}</a>${trailing}`;
  });
}

const textHtml = linkify(data.text);
const categoryUrl = data.category ? `/category/${categorySlug(data.category)}/` : null;
---

<BaseLayout
  title={`${postTitle} | آرشیو مفیدات`}
  description={excerpt}
  ogTitle={postTitle}
  ogDescription={excerpt}
>
  <div class="mx-auto max-w-3xl">
    <nav aria-label="مسیر صفحه" class="mb-4 flex flex-wrap items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-sky-600 dark:hover:text-sky-400">خانه</a>
      <span aria-hidden="true">›</span>
      {
        categoryUrl && data.category ? (
          <a href={categoryUrl} class="hover:text-sky-600 dark:hover:text-sky-400">
            {data.category}
          </a>
        ) : (
          <span>بدون دسته</span>
        )
      }
      <span aria-hidden="true">›</span>
      <span class="text-slate-700 dark:text-slate-300">{toPersianDigits(data.id)}</span>
    </nav>

    <article data-pagefind-body class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8 dark:border-slate-700 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-2">
        <MediaBadge type={data.media_type} duration={data.duration_sec} size="md" />
        <span data-pagefind-filter={`media:${data.media_type}`} class="sr-only">
          نوع محتوا: {mediaLabel(data.media_type)}
        </span>
        <time
          datetime={data.date.toISOString()}
          data-pagefind-meta={`date:${formatDate(data.date)}`}
          class="text-xs text-slate-500 dark:text-slate-400"
        >
          {formatDate(data.date)}
          <span class="mx-1 opacity-50">•</span>
          {formatRelative(data.date)}
        </time>
      </div>

      <h1 class="mt-4 text-center text-xl font-bold leading-9 text-slate-900 sm:text-2xl sm:leading-10 dark:text-slate-100">
        {postTitle}
      </h1>

      {
        textHtml ? (
          <div
            class="mt-6 whitespace-pre-line break-words text-base leading-8 text-slate-800 dark:text-slate-200"
            set:html={textHtml}
          />
        ) : (
          <p class="mt-6 text-sm italic text-slate-400 dark:text-slate-500">بدون متن</p>
        )
      }

      <section class="mt-8 rounded-3xl bg-sky-50 p-5 ring-1 ring-sky-200 sm:p-6 dark:bg-sky-500/10 dark:ring-sky-500/30">
        <p class="text-base font-bold text-sky-900 dark:text-sky-100">
          <span aria-hidden="true">{mediaEmoji(data.media_type)}</span>
          {' '}
          این {mediaLabel(data.media_type)} در تلگرام است
        </p>
        <p class="mt-2 text-sm leading-7 text-sky-800/80 dark:text-sky-200/80">
          برای شنیدن/دیدن، روی دکمهٔ زیر بزنید.
        </p>
        <a
          href={data.telegram_link}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-sky-600 px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-sky-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 focus-visible:ring-offset-2 sm:w-auto dark:bg-sky-500 dark:text-slate-950 dark:hover:bg-sky-400 dark:focus-visible:ring-offset-slate-900"
        >
          <span aria-hidden="true">←</span>
          باز کردن در تلگرام
        </a>
      </section>

      {
        data.category && categoryUrl && (
          <div class="mt-6 flex flex-wrap items-center gap-2">
            <span class="text-xs font-medium text-slate-500 dark:text-slate-400">دسته:</span>
            <a
              href={categoryUrl}
              class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700 transition hover:bg-sky-100 hover:text-sky-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-sky-500/20 dark:hover:text-sky-300"
            >
              #{data.category}
            </a>
          </div>
        )
      }
    </article>

    <div class="mt-6 flex justify-center">
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
      >
        <span aria-hidden="true">→</span>
        بازگشت به آرشیو
      </a>
    </div>
  </div>
</BaseLayout>
