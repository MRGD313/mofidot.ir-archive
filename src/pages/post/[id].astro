---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaBadge from '../../components/MediaBadge.astro';
import {
  categorySlug,
  formatDate,
  stripLeadingUrls,
  toPersianDigits,
} from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { id: String(post.data.id) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { data } = post;

const plainText = stripLeadingUrls(data.text);
const firstLine = plainText.split('\n')[0]?.trim() ?? '';
const postTitle = firstLine
  ? firstLine.length > 80
    ? `${firstLine.slice(0, 80)}…`
    : firstLine
  : `پست ${toPersianDigits(data.id)}`;

const compactText = plainText.replace(/\s+/g, ' ').trim();
const excerpt = compactText
  ? `${compactText.slice(0, 420)}${compactText.length > 420 ? '…' : ''}`
  : null;

const categoryLinks = data.categories.map((category) => ({
  name: category,
  url: `/category/${categorySlug(category)}/`,
}));
---

<BaseLayout
  title={`${postTitle} | مفیدات`}
  description={excerpt ?? 'پست کانال تلگرام مفیدات'}
  ogTitle={postTitle}
  ogDescription={excerpt ?? 'پست کانال تلگرام مفیدات'}
>
  <div class="mx-auto max-w-2xl">
    <nav aria-label="مسیر صفحه" class="mb-5 flex flex-wrap items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-brand-blue dark:hover:text-brand-blue-light">خانه</a>
      <span aria-hidden="true">›</span>
      {
        categoryLinks.length > 0 ? (
          <span class="inline-flex flex-wrap items-center gap-1">
            {categoryLinks.map((category, index) => (
              <>
                {index > 0 && <span aria-hidden="true">،</span>}
                <a
                  href={category.url}
                  class="hover:text-brand-blue dark:hover:text-brand-blue-light"
                >
                  {category.name}
                </a>
              </>
            ))}
          </span>
        ) : (
          <span>بدون دسته</span>
        )
      }
      <span aria-hidden="true">›</span>
      <span class="text-slate-700 dark:text-slate-300">{toPersianDigits(data.id)}</span>
    </nav>

    <article
      data-pagefind-body
      class="rounded-3xl border border-slate-200 bg-white p-6 text-center shadow-sm sm:p-10 dark:border-slate-700 dark:bg-slate-900"
    >
      <div class="flex flex-wrap items-center justify-center gap-2">
        <MediaBadge type={data.media_type} duration={data.duration_sec} size="md" />
        <span data-pagefind-filter={`media:${data.media_type}`} class="sr-only">
          نوع محتوا: {data.media_type}
        </span>
        <time
          datetime={data.date.toISOString()}
          data-pagefind-meta={`date:${formatDate(data.date)}`}
          class="text-xs text-slate-500 dark:text-slate-400"
        >
          {formatDate(data.date)}
        </time>
      </div>

      <h1 class="mt-5 text-2xl font-black leading-10 text-slate-900 sm:text-3xl sm:leading-[1.4] dark:text-slate-100">
        {postTitle}
      </h1>

      {
        excerpt ? (
          <p class="mt-5 text-sm leading-8 text-slate-600 dark:text-slate-300">
            {excerpt}
          </p>
        ) : (
          <p class="mt-5 text-sm italic text-slate-400 dark:text-slate-500">
            بدون متن
          </p>
        )
      }

      <a
        href={data.telegram_link}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 flex w-full items-center justify-center gap-2 rounded-3xl bg-brand-blue px-6 py-5 text-lg font-black text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-brand-blue-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue-light focus-visible:ring-offset-2 dark:bg-brand-blue-light dark:text-slate-950 dark:hover:bg-brand-blue dark:focus-visible:ring-offset-slate-900"
      >
        <span aria-hidden="true">↗</span>
        مشاهده و دانلود در تلگرام
      </a>

      <p class="mt-4 text-xs text-slate-500 dark:text-slate-400">
        این پست در تلگرام و بله موجود است.
      </p>
    </article>
  </div>
</BaseLayout>
