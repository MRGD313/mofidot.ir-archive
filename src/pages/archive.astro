---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import PostCard from '../components/PostCard.astro';
import { toPersianDigits } from '../lib/format';

const INITIAL_LIMIT = 60;
const PAGE_SIZE = 30;

const all = (await getCollection('posts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const categories = [
  ...new Set(all.flatMap((post) => post.data.categories)),
].sort((a, b) => a.localeCompare(b, 'fa'));

const activeCategory = Astro.url.searchParams.get('cat');
const activeMedia = Astro.url.searchParams.get('media');

const matchesFilters = (post: (typeof all)[number]): boolean =>
  (!activeCategory || post.data.categories.includes(activeCategory)) &&
  (!activeMedia || post.data.media_type === activeMedia);

let matchedSoFar = 0;
const items = all.map((post) => {
  const matches = matchesFilters(post);
  const visible = matches && matchedSoFar < INITIAL_LIMIT;
  if (matches) matchedSoFar += 1;
  return { post, visible };
});

const initialMatches = matchedSoFar;
const hasPosts = all.length > 0;
---

<BaseLayout
  title="آرشیو | مفیدات"
  description="آرشیو کامل پست‌های کانال تلگرام مفیدات"
  ogDescription="آرشیو کامل پست‌های کانال تلگرام مفیدات"
>
  <section
    data-pagefind-ignore={hasPosts ? '' : undefined}
    data-pagefind-body={hasPosts ? undefined : ''}
    class="space-y-6"
  >
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <a
          href="/"
          class="mb-3 inline-flex items-center gap-1 rounded text-xs font-medium text-brand-blue hover:text-brand-blue-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue dark:text-brand-blue-light dark:hover:text-brand-blue"
        >
          <span aria-hidden="true">→</span>
          بازگشت به خانه
        </a>
        <h1 class="text-2xl font-bold text-slate-900 sm:text-3xl dark:text-slate-100">
          آرشیو پست‌ها
        </h1>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          مرور کامل پست‌های کانال تلگرام مفیدات
        </p>
      </div>
      <p
        id="post-count"
        class="rounded-full border border-brand-blue/20 bg-brand-blue/5 px-3 py-1.5 text-xs font-medium text-brand-blue-dark shadow-sm dark:border-brand-blue/30 dark:bg-brand-blue/10 dark:text-brand-blue-light"
      >
        نمایش {toPersianDigits(initialMatches)} پست
      </p>
    </div>

    <CategoryFilter
      categories={categories}
      activeCategory={activeCategory}
      activeMedia={activeMedia}
      basePath="/archive"
    />

    {
      categories.length === 0 && (
        <div
          data-pagefind-ignore
          class="rounded-xl bg-amber-50 p-4 text-sm leading-7 text-amber-800 dark:bg-amber-500/10 dark:text-amber-200"
        >
          تاکسونومی هنوز ساخته نشده است. برای دسته‌بندی پست‌ها اسکریپت
          <code dir="ltr" class="inline-block rounded bg-white/50 px-1 py-0.5 dark:bg-black/30">--discover</code>
          و سپس
          <code dir="ltr" class="inline-block rounded bg-white/50 px-1 py-0.5 dark:bg-black/30">--initial</code>
          را اجرا کنید.
        </div>
      )
    }

    <div id="posts-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map(({ post, visible }) => (
          <div
            data-post
            data-categories={post.data.categories.join('|')}
            data-media={post.data.media_type}
            class:list={['h-full', visible ? '' : 'hidden']}
          >
            <PostCard post={post} />
          </div>
        ))
      }
    </div>

    <p
      id="no-results"
      class:list={[
        'rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400',
        initialMatches === 0 ? '' : 'hidden',
      ]}
    >
      {hasPosts ? 'پستی با این فیلترها پیدا نشد.' : 'هنوز پستی در آرشیو ثبت نشده است.'}
    </p>

    {
      all.length > INITIAL_LIMIT && (
        <div class="flex justify-center pt-2">
          <button
            id="load-more"
            type="button"
            class:list={[
              'rounded-full border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800',
              initialMatches > INITIAL_LIMIT ? '' : 'hidden',
            ]}
          >
            بارگذاری بیشتر
          </button>
        </div>
      )
    }
  </section>
</BaseLayout>

<script>
  import { toPersianDigits } from '../lib/format';

  const INITIAL_LIMIT = 60;
  const PAGE_SIZE = 30;

  const grid = document.getElementById('posts-grid');

  if (grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-post]'));
    const countElement = document.getElementById('post-count');
    const emptyElement = document.getElementById('no-results');
    const loadMoreButton = document.getElementById('load-more') as HTMLButtonElement | null;

    const initialParams = new URLSearchParams(window.location.search);
    let activeCategory = initialParams.get('cat');
    let activeMedia = initialParams.get('media');
    let visibleLimit = INITIAL_LIMIT;

    function syncChips(): void {
      document.querySelectorAll<HTMLElement>('a[data-filter]').forEach((chip) => {
        const value = chip.dataset.value ?? '';
        const active =
          chip.dataset.filter === 'cat'
            ? (activeCategory ?? '') === value
            : (activeMedia ?? '') === value;

        chip.dataset.active = String(active);
        if (active) chip.setAttribute('aria-current', 'page');
        else chip.removeAttribute('aria-current');
      });
    }

    function applyFilters(): void {
      let matched = 0;

      for (const card of cards) {
        const cardCategories = (card.dataset.categories || '')
          .split('|')
          .filter(Boolean);
        const categoryMatches =
          !activeCategory || cardCategories.includes(activeCategory);
        const mediaMatches = !activeMedia || card.dataset.media === activeMedia;
        const matches = categoryMatches && mediaMatches;
        const visible = matches && matched < visibleLimit;

        if (matches) matched += 1;
        card.classList.toggle('hidden', !visible);
      }

      if (countElement) {
        countElement.textContent = `نمایش ${toPersianDigits(matched)} پست`;
      }

      emptyElement?.classList.toggle('hidden', matched !== 0);
      loadMoreButton?.classList.toggle('hidden', matched <= visibleLimit);
    }

    function updateURL(): void {
      const params = new URLSearchParams();
      if (activeCategory) params.set('cat', activeCategory);
      if (activeMedia) params.set('media', activeMedia);

      const query = params.toString();
      const nextUrl = query
        ? `${window.location.pathname}?${query}`
        : window.location.pathname;
      history.replaceState(null, '', nextUrl);
    }

    document.querySelectorAll<HTMLAnchorElement>('a[data-filter]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }

        event.preventDefault();
        const value = link.dataset.value || null;

        if (link.dataset.filter === 'cat') activeCategory = value;
        else if (link.dataset.filter === 'media') activeMedia = value;

        visibleLimit = INITIAL_LIMIT;
        syncChips();
        applyFilters();
        updateURL();
      });
    });

    loadMoreButton?.addEventListener('click', () => {
      visibleLimit += PAGE_SIZE;
      applyFilters();
    });

    window.addEventListener('popstate', () => {
      const params = new URLSearchParams(window.location.search);
      activeCategory = params.get('cat');
      activeMedia = params.get('media');
      visibleLimit = INITIAL_LIMIT;
      syncChips();
      applyFilters();
    });

    syncChips();
    applyFilters();
  }
</script>
