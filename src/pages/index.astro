---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { categorySlug, toPersianDigits } from '../lib/format';

const all = (await getCollection('posts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const categoryCounts = new Map<string, number>();
for (const post of all) {
  for (const category of post.data.categories) {
    categoryCounts.set(category, (categoryCounts.get(category) ?? 0) + 1);
  }
}

const categories = [...categoryCounts.keys()].sort((a, b) => a.localeCompare(b, 'fa'));
const recentPosts = all.slice(0, 3);
---

<BaseLayout
  title="مفیدات | آرشیو کانال"
  description="داشبورد آرشیو کانال تلگرام مفیدات"
>
  <div data-pagefind-ignore class="space-y-16 pb-4 sm:space-y-20">
    <section class="mx-auto max-w-3xl pt-4 text-center sm:pt-8">
      <p class="text-xs font-bold tracking-wide text-brand-blue dark:text-brand-blue-light">
        آرشیو کانال مفیدات
      </p>
      <h1 class="mt-3 text-4xl font-black leading-tight text-slate-900 sm:text-5xl dark:text-slate-100">
        چه چیزی دنبال می‌کنی؟
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-slate-500 dark:text-slate-400">
        میان {toPersianDigits(all.length)} پست جستجو کن یا از دسته‌بندی‌ها شروع کن.
      </p>

      <button
        id="home-search"
        type="button"
        aria-haspopup="dialog"
        aria-label="جستجو در آرشیو"
        class="group mx-auto mt-8 block w-full max-w-2xl rounded-2xl border-2 border-brand-blue/20 bg-white p-4 text-right shadow-sm transition hover:-translate-y-0.5 hover:border-brand-blue/50 hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue dark:border-brand-blue/30 dark:bg-slate-900 dark:hover:border-brand-blue-light/60"
      >
        <span class="flex items-center justify-between gap-4">
          <span class="flex items-center gap-3">
            <span class="text-2xl transition group-hover:scale-110" aria-hidden="true">🔍</span>
            <span class="text-sm text-slate-400 dark:text-slate-500">جستجو در آرشیو...</span>
          </span>
          <span class="hidden rounded-lg border border-slate-200 px-2 py-1 text-[10px] text-slate-400 sm:inline dark:border-slate-700 dark:text-slate-500">
            Ctrl K
          </span>
        </span>
      </button>
    </section>

    <section aria-labelledby="categories-title">
      <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 id="categories-title" class="text-2xl font-black text-slate-900 sm:text-3xl dark:text-slate-100">
            دسته‌بندی‌ها
          </h2>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            از موضوع مورد علاقه‌ات شروع کن
          </p>
        </div>
        <a
          href="/archive"
          class="inline-flex items-center gap-1 rounded text-sm font-medium text-brand-blue transition hover:text-brand-blue-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue dark:text-brand-blue-light dark:hover:text-brand-blue"
        >
          مشاهدهٔ همهٔ پست‌ها
          <span aria-hidden="true">←</span>
        </a>
      </div>

      {
        categories.length > 0 ? (
          <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
            {categories.map((category) => (
              <a
                href={`/category/${categorySlug(category)}/`}
                class="group flex min-h-32 flex-col justify-between rounded-2xl bg-slate-50 p-6 shadow-sm ring-1 ring-slate-200 transition duration-200 hover:-translate-y-0.5 hover:bg-brand-blue/5 hover:ring-brand-blue/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue dark:bg-slate-900 dark:ring-slate-800 dark:hover:bg-brand-blue/10 dark:hover:ring-brand-blue/30"
              >
                <span class="text-base font-bold leading-7 text-slate-900 transition group-hover:text-brand-blue-dark sm:text-lg dark:text-slate-100 dark:group-hover:text-brand-blue-light">
                  {category}
                </span>
                <span class="mt-6 flex items-center justify-between gap-3">
                  <span class="text-xs text-slate-500 dark:text-slate-400">
                    {toPersianDigits(categoryCounts.get(category) ?? 0)} پست
                  </span>
                  <span class="h-1 w-8 rounded-full bg-gradient-to-l from-brand-red to-brand-blue" aria-hidden="true"></span>
                </span>
              </a>
            ))}
          </div>
        ) : (
          <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
            هنوز دسته‌بندی‌ای ساخته نشده است.
          </div>
        )
      }
    </section>

    <section aria-labelledby="recent-title">
      <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 id="recent-title" class="text-2xl font-black text-slate-900 sm:text-3xl dark:text-slate-100">
            آخرین پست‌ها
          </h2>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            تازه‌ترین مطالب منتشرشده
          </p>
        </div>
        <a
          href="/archive"
          class="inline-flex items-center gap-1 rounded text-sm font-medium text-brand-blue transition hover:text-brand-blue-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue dark:text-brand-blue-light dark:hover:text-brand-blue"
        >
          مشاهده آرشیو کامل
          <span aria-hidden="true">←</span>
        </a>
      </div>

      {
        recentPosts.length > 0 ? (
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {recentPosts.map((post) => <PostCard post={post} />)}
          </div>
        ) : (
          <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
            هنوز پستی در آرشیو ثبت نشده است.
          </div>
        )
      }
    </section>

    <section aria-labelledby="social-title">
      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 dark:border-slate-800 dark:bg-slate-900">
        <h2 id="social-title" class="text-2xl font-black text-slate-900 dark:text-slate-100">
          همراه ما باش
        </h2>
        <p class="mt-2 text-sm leading-7 text-slate-500 dark:text-slate-400">
          محتوای تازه در تلگرام و بله منتشر می‌شود.
        </p>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a
            href="https://t.me/Mofidot"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-1 items-center justify-between gap-4 rounded-2xl bg-brand-blue px-5 py-4 text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-brand-blue-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue-light focus-visible:ring-offset-2 dark:bg-brand-blue-light dark:text-slate-950 dark:hover:bg-brand-blue"
          >
            <span class="flex items-center gap-3">
              <span class="text-2xl" aria-hidden="true">✈️</span>
              <span>
                <span class="block text-base font-bold">تلگرام</span>
                <span class="block text-xs opacity-80">@Mofidot</span>
              </span>
            </span>
            <span class="text-xl transition group-hover:-translate-x-1" aria-hidden="true">←</span>
          </a>

          <a
            href="https://ble.ir/Mofidot"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-1 items-center justify-between gap-4 rounded-2xl bg-brand-red px-5 py-4 text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-brand-red-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-red-light focus-visible:ring-offset-2 dark:bg-brand-red-light dark:text-slate-950 dark:hover:bg-brand-red"
          >
            <span class="flex items-center gap-3">
              <span class="text-2xl" aria-hidden="true">💬</span>
              <span>
                <span class="block text-base font-bold">بله</span>
                <span class="block text-xs opacity-80">@Mofidot</span>
              </span>
            </span>
            <span class="text-xl transition group-hover:-translate-x-1" aria-hidden="true">←</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const homeSearch = document.getElementById('home-search');
  const headerSearch = document.getElementById('search-trigger');

  homeSearch?.addEventListener('click', () => {
    headerSearch?.click();
  });
</script>
